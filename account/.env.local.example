# ===========================================
# Lead Agents Studio - Account System
# ===========================================

# Auth.js Secret (generate with: npx auth secret)
AUTH_SECRET=

# Database URL
DATABASE_URL="postgresql://user:password@localhost:5432/lead_agents_studio"

# Google OAuth (optional)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Stripe Payment Links (just URLs - no API keys needed)
NEXT_PUBLIC_STRIPE_DEMO_LINK=https://buy.stripe.com/your-5-dollar-demo-link
STRIPE_LINK_10=https://buy.stripe.com/your-10-credits-link
STRIPE_LINK_50=https://buy.stripe.com/your-50-credits-link
STRIPE_LINK_200=https://buy.stripe.com/your-200-credits-link

# App URL (Auth.js v5 also uses AUTH_URL in production)
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# Quick Fit survey → Notion
# 1) https://www.notion.so/my-integrations → Internal integration → copy secret → NOTION_INTERNAL_TOKEN
# 2) NOTION_SURVEY_DATABASE_ID must be the *database* (table), NOT a parent page:
#    Open the survey database full-page in Notion → copy link → id is the last 32 hex in the URL
#    (e.g. …/944a5aaa128642a38092765ced8fe57e?v=…). Wrong: id of a normal page that only *contains* the DB.
# 3) On that database: ⋯ → Connections → add the same integration (or rows never appear).
# 4) Optional: leave NOTION_SURVEY_DATABASE_ID empty and set NOTION_PARENT_PAGE_ID → DB auto-created on first submit.
#    (or: node scripts/create-notion-survey-database.mjs)
NOTION_INTERNAL_TOKEN=
NOTION_SURVEY_DATABASE_ID=
NOTION_PARENT_PAGE_ID=

# Thank-you / routing (optional; survey still works without them)
# If your live domain is not leadagentsstudio.com, set this (no trailing slash)
NEXT_PUBLIC_SITE_MARKETING_BASE=
# Calendly: defaults to same link as marketing site (aumi4-support/30min) if unset
NEXT_PUBLIC_CALENDLY_URL=
# Optional; defaults to {NEXT_PUBLIC_SITE_MARKETING_BASE or leadagentsstudio.com}/
NEXT_PUBLIC_SURVEY_OFFER_URL=
# Optional override; default thank-you coupon code on the page is SURVEY
NEXT_PUBLIC_SURVEY_OFFER_CODE=
NEXT_PUBLIC_SURVEY_DEMO_URL=
NEXT_PUBLIC_SURVEY_AGENCY_PAGE_URL=
NEXT_PUBLIC_SURVEY_PORTFOLIO_URL=

# Mailgun visitor opt-in list
# MAILGUN_REGION can be US (default) or EU.
MAILGUN_API_KEY=
MAILGUN_REGION=US
MAILGUN_VISITOR_LIST_ADDRESS=support@smartlineagents.com
